# Colab 每次启动后 cloudflared 输出的穿透地址（末尾不要加斜杠）
COLAB_API_URL=https://replace-with-your-tunnel.trycloudflare.com

# 默认工作流映射配置路径
WORKFLOW_BINDINGS_FILE=configs/workflow_bindings.example.yaml

# 单个镜头渲染超时时间（秒），Wan 2.2 14B 或长视频对口型建议 >= 900
JOB_TIMEOUT_SECONDS=1200

# 单镜头失败自动重试次数
JOB_MAX_RETRIES=2

# HTTP 轮询间隔（秒，当 WebSocket 不可用时降级使用）
POLL_INTERVAL_SECONDS=5
