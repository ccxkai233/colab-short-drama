# 单实例模式：Colab 每次启动后 cloudflared 输出的穿透地址（末尾不要加斜杠）
COLAB_API_URL=https://replace-with-your-tunnel.trycloudflare.com

# 多实例并发模式（可选，非空时优先于 COLAB_API_URL）：
# 同时开 2~3 台 Colab（或其他云端 ComfyUI）时，用英文逗号拼接所有地址即可自动并行抢单
# COLAB_API_URLS=https://worker1.trycloudflare.com,https://worker2.trycloudflare.com

# 默认工作流映射配置路径
WORKFLOW_BINDINGS_FILE=configs/workflow_bindings.yaml

# 单个镜头渲染超时时间（秒），MiniMax H3 满血 768p 在 L4 上建议 >= 3600
JOB_TIMEOUT_SECONDS=3600

# 单镜头失败自动重试次数
JOB_MAX_RETRIES=2

# HTTP 轮询间隔（秒，当 WebSocket 不可用时降级使用）
POLL_INTERVAL_SECONDS=5
